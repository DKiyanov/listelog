# Сетевые настройки
PORT=8732

LDAP_DOMAIN=your_ldap_domain
LDAP_SERVER=your_ldap_server
	
# Системные настройки
TOKEN_LIFETIME_HOURS=1000
VERBOSE=false
DEMO_LOGIN=TEST

# Путь на хост-машине (для volumes)
HOST_AUDIO_DATA_DIR=../server_folders/audio_data
HOST_SESSIONS_DIR=../server_folders/sessions
HOST_USERS_DIR=../server_folders/users
HOST_SITE_DIR=../site