# Сетевые настройки
#MAIN_URL=ws://
PORT=8732

# Путь на хост-машине (для volumes)
HOST_AUDIO_DATA_DIR=../../server_folders/audio_data
HOST_SESSIONS_DIR=../../server_folders/sessions
HOST_MODELS_DIR=./models

NEXT_WORK_TYPE=spkemb

MOSS_TRANSCRIBE_MODEL_PATH=moss/mudler/moss-transcribe.cpp-gguf/moss-transcribe-q8_0.gguf
PROMPT=<previous_transcribe_text>\n[context]\n</previous_transcribe_text>\naudio recording in Russian\n[default_prompt]
CONTEXT_LENGTH=20

MAX_DURATION_KF=1.0
MAX_DURATION_ADD=0.0