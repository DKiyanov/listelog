# Сетевые настройки
#MAIN_URL=ws://
PORT=8732

# Пути на хост-машине (для volumes)
HOST_AUDIO_DATA_DIR=../../server_folders/audio_data
HOST_SESSIONS_DIR=../../server_folders/sessions
HOST_MODELS_DIR=./models
	  
# Настройки воркера
MODE=ws # ws - web-service; fs - переодическое сканирование каталогов
WAIT_TIME=2 # время в сек. между попытками подключения к серверу
VERBOSE=true

# Настрйки запуска модели faster-whisper
MODEL_PATH=faster-whisper/dvislobokov/faster-whisper-large-v3-turbo-russian
DEVICE=cuda
COMPUTE_TYPE=float16
LANGUAGE=ru

MAX_DURATION_KF=1.0
MAX_DURATION_ADD=0.0