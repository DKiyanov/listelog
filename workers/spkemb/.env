# Сетевые настройки
#MAIN_URL=ws://
PORT=8732

# Пути на хост-машине (для volumes)
HOST_AUDIO_DATA_DIR=.../server_folders/audio_data
HOST_SESSIONS_DIR=.../server_folders/sessions
HOST_USERS_DIR=.../server_folders/users
HOST_MODELS_DIR=./models
	  
# Настройки воркера
MODE=ws # ws - web-service; fs - переодическое сканирование каталогов
WAIT_TIME=2 # время в сек. между попытками подключения к серверу
VERBOSE=true

# Пути к моделям
SILERO_VAD_MODEL_PATH=silero-vad/silero_vad.onnx
WESPEAKER_MODEL_PATH=wespeaker/wespeaker-wespeaker-voxceleb-redimnet2-B6-LM

# Специаьные настройки воркера
WESPEAKER_BATCH_SIZE=1
WESPEAKER_THRESHOLD=0.65
WESPEAKER_DEVICE=cuda

MAX_DURATION_KF=1.0
MAX_DURATION_ADD=0.0