# Автоматически приводить все текстовые файлы к LF при коммите
* text=auto
# Принудительно делать LF для скриптов, даже если они созданы в Windows
*.sh text eol=lf
*.bash text eol=lf
site/assets/ListeLog_lnx.run filter=lfs diff=lfs merge=lfs -text
site/assets/ListeLog_win.exe filter=lfs diff=lfs merge=lfs -text