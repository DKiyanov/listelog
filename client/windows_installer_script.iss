; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "ListeLog"
#define MyAppVersion "1.0"
#define MyAppPublisher "DKiyanov"
#define MyAppURL "https://www.dkiyanov.com/"
#define MyAppExeName "listelog.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{E1A59B40-3E56-4B4E-A8F2-DA2F0B0A5DAC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
; Uncomment the following line to use a 64-bit installer.
;SetupArchitecture=x64
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputDir=xbuild\windows
OutputBaseFilename=ListeLog_win
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "xbuild\windows\dist\listelog\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "xbuild\windows\dist\listelog\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
// Извлекает URL сервера из имени файла дистрибутива
function GetServerUrlFromFileName(): String;
var
  ExePath: String;
  ExeName: String;
  Protocol: String;
  UrlPart: String;
  PosSign: Integer;
  PosDot: Integer;
begin
  Result := '';
  
  // Получаем полное имя запущенного .exe файла
  ExePath := ExpandConstant('{srcexe}');
  ExeName := ExtractFileName(ExePath);

  // Ищем начальный символ (% или $)
  PosSign := Pos('%', ExeName);
  if PosSign > 0 then
  begin
    Protocol := 'http://';
  end
  else
  begin
    PosSign := Pos('$', ExeName);
    if PosSign > 0 then
      Protocol := 'https://'
    else
      Exit; // Если символов # или $ нет, выходим
  end;

  // Ищем точку после спецсимвола, которая отсекает расширение .exe
  // Начинаем поиск с позиции спецсимвола
  PosDot := Pos('.', Copy(ExeName, PosSign, Length(ExeName)));
  if PosDot > 0 then
  begin
    // Вычисляем реальную позицию точки в исходной строке
    PosDot := PosSign + PosDot - 1;
    
    // Вырезаем фрагмент между значком (#/$) и точкой (.)
    UrlPart := Copy(ExeName, PosSign + 1, PosDot - PosSign - 1);
    
    // Заменяем запятые на точки, а точки с запятой на двоеточия
    StringChangeEx(UrlPart, ',', '.', True);
    StringChangeEx(UrlPart, ';', ':', True);
    
    // Собираем итоговый URL
    Result := Protocol + UrlPart;
  end;
end;

// Сохраянет URL сервера из имени файла дистрибутива в main_ini.json
procedure SaveMainIni();
var
  ServerUrl: String;
  JsonContent: String;
  FilePath: String;
  FileLines: TArrayOfString;
begin
  ServerUrl := GetServerUrlFromFileName();
    
  if ServerUrl = '' then
  begin
    Log('Не удалось извлечь адрес сервера из имени файла: ' + ExtractFileName(ExpandConstant('{srcexe}')));
	Exit;
  end;
  
  // Формируем путь к файлу main_ini.json в целевой папке установки
  FilePath := ExpandConstant('{app}\main_config.json');
      
  // Формируем структуру JSON (экранируем обратные слэши, если они будут)
  JsonContent := '{' + #13#10 + '  "base_url":"' + ServerUrl + '"' + #13#10 + '}';
      
  // Записываем контент в файл
  SetArrayLength(FileLines, 1);
  FileLines[0] := JsonContent;
      
  if SaveStringsToFile(FilePath, FileLines, False) then
    Log('Файл main_config.json успешно создан с URL: ' + ServerUrl)
  else
    Log('Ошибка при сохранении файла main_config.json');
end;

// Функция для проверки наличия ffmpeg в системе
function IsFFmpegInstalled(): Boolean;
var
  ResultCode: Integer;
begin
  // Пробуем запустить 'ffmpeg -version' в скрытом режиме.
  // Если утилита доступна в PATH, код возврата будет равен 0.
  if Exec('cmd.exe', '/c ffmpeg -version', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    Result := (ResultCode = 0);
  end
  else
  begin
    Result := False;
  end;
end;

// Процедура, которая вызывается при переходе к шагу установки
procedure CurStepChanged(CurStep: TSetupStep);
begin
  // Выполняем проверку непосредственно перед началом копирования файлов
  if CurStep = ssInstall then
  begin
    if not IsFFmpegInstalled() then
    begin
      SuppressibleMsgBox(
        'Внимание: На вашем компьютере не обнаружен ffmpeg.' + #13#10 + #13#10 +
        'Для корректной работы приложения вам необходимо самостоятельно установить ffmpeg ' +
        'и добавить путь к нему в системную переменную PATH.' + #13#10 + #13#10 +
        'Установка приложения будет продолжена.', 
        mbInformation, MB_OK, MB_OK
      );
    end;
  end;
  
  // После завершения копирования файлов
  if CurStep = ssPostInstall then    
  begin
    SaveMainIni();
  end;
end;
